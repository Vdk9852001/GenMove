# Copy this file to .env and replace the password.
# Using separate PG_* values safely handles special characters in passwords.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=genmove
PG_USER=postgres
PG_PASSWORD=user123
PG_CONNECT_TIMEOUT=10

# Alternatively, remove the PG_* values above and use one URL:
# DATABASE_URL=postgresql+psycopg://genmove:password@127.0.0.1:5432/genmove

SAP_VALIDATOR_PORT=5050
# Set a long random value in production.
# GENMOVE_SECRET_KEY=replace-with-a-long-random-secret
